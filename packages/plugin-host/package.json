{
  "name": "@codearena/plugin-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lê codearena.config.json, resolve os pacotes de plugin e gera o carregamento sob demanda no Vite.",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./vite": {
      "types": "./src/vite.d.mts",
      "default": "./src/vite.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "semver": "^7.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/semver": "^7.7.0",
    "vite": "^6.4.1"
  }
}
