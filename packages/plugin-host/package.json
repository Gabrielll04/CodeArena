{
  "name": "@codearena/plugin-host",
  "version": "0.1.0",
  "type": "module",
  "description": "Lê codearena.config.json, resolve os pacotes de plugin e gera o carregamento sob demanda no Vite.",
  "keywords": [
    "codearena",
    "plugin",
    "vite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabrielll04/CodeArena.git",
    "directory": "packages/plugin-host"
  },
  "homepage": "https://github.com/Gabrielll04/CodeArena#readme",
  "bugs": "https://github.com/Gabrielll04/CodeArena/issues",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./vite": {
      "types": "./src/vite.d.mts",
      "default": "./src/vite.mjs"
    },
    "./cli": {
      "types": "./src/cli.d.mts",
      "default": "./src/cli.mjs"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "semver": "^7.7.2",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/semver": "^7.7.0",
    "vite": "^6.4.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "codearena": "./src/cli.mjs"
  }
}
