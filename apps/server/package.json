{
  "name": "@codearena/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor de salas em tempo real do CodeArena (Fastify + Socket.IO).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@codearena/core": "workspace:*",
    "@codearena/plugin-backend-http": "workspace:*",
    "@codearena/plugin-react-native": "workspace:*",
    "@codearena/plugin-sdk": "workspace:*",
    "@codearena/schemas": "workspace:*",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  }
}
